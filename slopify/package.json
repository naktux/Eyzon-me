{
  "name": "eyzon-me",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open /dashboard.html",
    "build": "tsc --noEmit && node scripts/build-extension.mjs",
    "start": "npm run build",
    "voice:generate": "node scripts/generate-voice.mjs",
    "lint": "eslint components hooks extension lib scripts tests",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "ml-matrix": "^6.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "description": "Eyzon-me: a local focus companion named Eyzon",
  "author": "Eyzon-me"
}
